{
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9000
    },
    "eventarc": {
      "port": 9299
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5005
    },
    "pubsub": {
      "port": 8085
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  },
  "firestore": {
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions"
    }
  ],
  "hosting": {
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": "public",
    "rewrites": [
      {
        "source": "/privacy.it",
        "destination": "/privacy.it.html"
      },
      {
        "source": "/privacy.en",
        "destination": "/privacy.en.html"
      },
      {
        "source": "/terms.it",
        "destination": "/terms.it.html"
      },
      {
        "source": "/terms.en",
        "destination": "/terms.en.html"
      },
      {
        "source": "/support.it",
        "destination": "/support.it.html"
      },
      {
        "source": "/support.en",
        "destination": "/support.en.html"
      },
      {
        "destination": "/privacy.html",
        "source": "/privacy"
      },
      {
        "destination": "/terms.html",
        "source": "/terms"
      },
      {
        "destination": "/support.html",
        "source": "/support"
      }
    ],
    "site": "splixy",
    "headers": [
      {
        "source": "/@(privacy|terms|support).@(it|en)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
