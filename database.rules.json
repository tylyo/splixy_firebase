{
  "rules": {
    "apnToken": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "categories": {
      "$c_id": {
        ".write": "false"
      },
      ".read": "auth.uid !== null"
    },
    "credits": {
      "$c_id": {
        ".write": "false"
      },
      ".read": "auth.uid !== null"
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "logEvents": {
      "$wid": {
        ".read": "auth !== null",
        ".write": "auth !== null"
      }
    },
    "purchases": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "transactions": {
      "$wid": {
        "$trxId": {
          ".indexOn": [
            "date",
            "updated"
          ],
          ".read": "auth.uid !== null && root.child('wallets').child($wid).child('acl/r').child(auth.uid).val() === true",
          ".write": "auth.uid !== null && root.child('wallets').child($wid).child('acl/w').child(auth.uid).val() === true",
          "a": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          }
        },
        ".read": "auth.uid !== null && root.child('wallets').child($wid).child('acl/r').child(auth.uid).val() === true",
        ".write": "auth.uid !== null && root.child('wallets').child($wid).child('acl/w').child(auth.uid).val() === true"
      }
    },
    "usersDeleted": {
      ".indexOn": ["purgeAt"]
    },
    "users": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid && (newData.child('su').val() === true) === (data.child('su').val() === true) && (newData.child('sub/ios').val() === data.child('sub/ios').val() || newData.child('sub/ios').val() === null) && (newData.child('sub/android').val() === data.child('sub/android').val() || newData.child('sub/android').val() === null) && newData.child('subData/platform').val() === data.child('subData/platform').val() && newData.child('subData/expireAt').val() === data.child('subData/expireAt').val() && newData.child('subData/verifiedAt').val() === data.child('subData/verifiedAt').val() && newData.child('subData/txId').val() === data.child('subData/txId').val() && (newData.child('subData/role').val() === data.child('subData/role').val() || newData.child('subData/role').val() === 'free') && (newData.child('subData/status').val() === data.child('subData/status').val() || newData.child('subData/status').val() === 'expired')"
      }
    },
    "subscriptions": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        "$platform": {
          ".validate": "$platform === 'ios' || $platform === 'android'",
          "$purchaseId": {
            ".write": "auth !== null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['productId', 'serverVerificationData']) && newData.child('productId').isString() && newData.child('serverVerificationData').isString() && newData.child('serverVerificationData').val().length <= 20000"
          }
        }
      }
    },
    "subscriptionVerifications": {
      ".read": false,
      ".write": false
    },
    "purchaseIndex": {
      ".read": false,
      ".write": false
    },
    "activeSubscriptions": {
      ".read": false,
      ".write": false,
      ".indexOn": [".value"]
    },
    "wallets": {
      "$wid": {
        ".read": "auth.uid !== null && data.child('acl/r').child(auth.uid).val() === true",
        ".validate": "auth.uid !== null",
        ".write": "auth.uid !== null && (newData.child('acl/w').child(auth.uid).val() === true || data.child('acl/c').child(auth.uid).val() === true) ",
        "acl": {
          ".indexOn": [
            "c",
            "r",
            "w"
          ]
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 35"
        }
      },
      ".indexOn": [
        "acl/c/OVUtwD08WlWUyeiQB4RZjJVgImy2",
        "acl/w",
        "acl/r",
        "creator",
        "created",
        "sl"
      ],
      ".read": "auth.uid !== null"
    }
  }
}